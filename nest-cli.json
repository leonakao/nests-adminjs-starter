{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "deleteOutDir": true,
    "watchAssets": false,
    "assets": [],
    "webpack": false
  },
  "watchModeOptions": {
    "ignore": ["dist", "node_modules", "**/*.spec.ts", "**/*.test.ts", "adminjs/bundle.js"]
  }
}
